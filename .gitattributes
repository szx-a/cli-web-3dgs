# Windows 脚本必须保持 CRLF（PowerShell 5.1 对 LF 的 .ps1 兼容性差）
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
# 其余文本统一 LF，避免跨平台 diff 噪声
*.py text eol=lf
*.md text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.toml text eol=lf
# 二进制
*.png binary
*.jpg binary
*.ply binary
*.glb binary
*.splat binary
*.pth binary
